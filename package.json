{
  "name": "cat-status",
  "version": "1.0.0",
  "private": true,
  "description": "Print or save http.cat images for known HTTP status codes.",
  "author": "Amy Waliszewska",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hakierka/docs-the-agent-can-read.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "cat-status": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "npm run dev --prefix docs",
    "docs:build": "npm run build --prefix docs",
    "docs:check-links": "npm run check-links --prefix docs",
    "eval:dry-run": "npm run dry-run --prefix eval",
    "eval:test": "npm test --prefix eval"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
